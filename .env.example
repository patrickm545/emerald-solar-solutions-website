# Production site URL used for canonical URLs, Open Graph URLs, sitemap.xml,
# robots.txt, and JSON-LD IDs.
NEXT_PUBLIC_SITE_URL=https://emeraldsolarsolutions.ie

# Optional public business details for LocalBusiness schema and launch checks.
# Leave blank until the real approved business details are available.
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_STREET_ADDRESS=
NEXT_PUBLIC_BUSINESS_LOCALITY=
NEXT_PUBLIC_BUSINESS_REGION=
NEXT_PUBLIC_BUSINESS_POSTAL_CODE=
NEXT_PUBLIC_BUSINESS_COUNTRY=IE
NEXT_PUBLIC_BUSINESS_PHOTO_URL=

# Do not add review/rating/testimonial schema until real reviews are collected
# and approved for publication.

# Admin protection for private site administration routes.
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional secure webhook target for contact form delivery.
# If left blank, submissions are written to storage/contact-requests.jsonl
# on the server and never exposed from /public.
CONTACT_FORM_WEBHOOK_URL=
CONTACT_FORM_WEBHOOK_BEARER_TOKEN=
